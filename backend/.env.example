PROJECT_NAME=OSTEOGUARD-NER Backend
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_DEMO_MODE=true
MODEL_PROVIDER=rule_based

SECRET_KEY=change_this_to_a_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

DATABASE_URL=postgresql+psycopg2://osteouser:osteopass@localhost:5432/osteoguard
CORS_ORIGINS=["*"]

MIN_DATA_COMPLETENESS_THRESHOLD=0.80
RED_FLAG_PAIN_THRESHOLD=8
